#!/bin/zsh
# MACSTACK PLUGIN: mac-license
# @describe: Display MIT license

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'EOF'
mac license — display MIT license

Usage:
  mac license
EOF
  exit 0
fi

print -r -- ""
print -r -- "${COLOR_INFO}#================================================================#${COLOR_RESET}"
print -r -- "${COLOR_INFO}#${COLOR_RESET}                         ${COLOR_BOLD}M A C S T A C K${COLOR_RESET}                        ${COLOR_INFO}#${COLOR_RESET}"
print -r -- "${COLOR_INFO}#${COLOR_RESET}                        MIT LICENSE (2025)                      ${COLOR_INFO}#${COLOR_RESET}"
print -r -- "${COLOR_INFO}#================================================================#${COLOR_RESET}"
print -r -- ""
print -r -- "${COLOR_SUCCESS}Copyright (c) 2025 MathAndEmotion${COLOR_RESET}"
print -r -- ""
print -r -- "${COLOR_INFO}Permission is hereby granted, free of charge, to any person obtaining a copy"
print -r -- "of this software and associated documentation files (the \"Software\"), to deal"
print -r -- "in the Software without restriction, including without limitation the rights"
print -r -- "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell"
print -r -- "copies of the Software, and to permit persons to whom the Software is"
print -r -- "furnished to do so, subject to the following conditions:"
print -r -- ""
print -r -- "The above copyright notice and this permission notice shall be included in all"
print -r -- "copies or substantial portions of the Software.${COLOR_RESET}"
print -r -- ""
print -r -- "${COLOR_WARN}THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR"
print -r -- "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,"
print -r -- "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE"
print -r -- "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER"
print -r -- "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,"
print -r -- "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE"
print -r -- "SOFTWARE.${COLOR_RESET}"
print -r -- ""
