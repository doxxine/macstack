#!/bin/zsh
# MACSTACK PLUGIN: mac-finder
# @describe: Finder helpers

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || true

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac finder — Finder helpers

Usage:
  mac finder open   # open Finder in current directory
EOF
  exit 0
fi

shift

case "$command" in

  open)
    print -r -- "${COLOR_INFO}>> opening Finder at current directory${COLOR_RESET}"
    open .
    ;;

  *)
    print_error "UNKNOWN FINDER SUBCOMMAND: ${command}"
    print_error "TRY: mac finder --help"
    exit 2
    ;;

esac
