#!/bin/zsh
# MACSTACK PLUGIN: mac-emo
# @describe: Quick ASCII emotions (copied to clipboard)

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || true

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac emo — quick ASCII emotions (copied to clipboard)

Usage:
  mac emo shrug
  mac emo flip-table
  mac emo fight
  mac emo lenny
  mac emo confused
  mac emo cry
  mac emo happy
  mac emo vibecheck
  mac emo sus
  mac emo fireline
  mac emo comeon
  mac emo nottoday
EOF
  exit 0
fi

shift

print_and_copy() {
  local content="$1"
  local description="$2"
  print -r -- "${COLOR_INFO}>> $description${COLOR_RESET}"
  print -r -- "$content"
  printf "%s" "$content" | pbcopy
}

case "$command" in

  shrug)
    print_and_copy "¯\\_(ツ)_/¯" "I don't know, man."
    ;;

  flip-table)
    print_and_copy "(╯°□°）╯︵ ┻━┻" "Frustration unleashed."
    ;;

  fight)
    print_and_copy "(ง'̀-'́)ง" "Ready to throw hands."
    ;;

  lenny)
    print_and_copy "( ͡° ͜ʖ ͡°)" "Suspicious energy."
    ;;

  confused)
    print_and_copy "(°ロ°) !?" "Say what?"
    ;;

  cry)
    print_and_copy "(ಥ﹏ಥ)" "Full emotional collapse."
    ;;

  happy)
    print_and_copy "(＾▽＾)" "Wholesome joy."
    ;;

  vibecheck)
    print_and_copy "vibe check complete" "Mood scan complete."
    ;;

  sus)
    print_and_copy "that's kinda sus bro" "Impostor energy."
    ;;

  fireline)
    print_and_copy "TODAY YOU" "You're on fire."
    ;;

  comeon)
    print_and_copy "come on, just one more PR" "Soft pleading."
    ;;

  nottoday)
    print_and_copy "not today Satan" "Hard pass."
    ;;

  *)
    print_error "UNKNOWN EMO SUBCOMMAND: ${command}"
    print_error "TRY: mac emo --help"
    exit 2
    ;;

esac
