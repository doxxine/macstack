#!/bin/zsh
# MACSTACK PLUGIN: mac-net
# STYLE: UNIX / SNAKE_CASE

set -euo pipefail

# DO NOT CHANGE THIS LINE (MACROOT RESOLUTION VIA SYMLINK-AWARE READLINK)
MACROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
MACROOT="$(cd "$MACROOT/.." && pwd)"

[[ -f "$MACROOT/lib/shared.zsh" ]] || { echo "mac: missing shared lib: $MACROOT/lib/shared.zsh" >&2; exit 1; }
source "$MACROOT/lib/shared.zsh"
macstack_load_config || true

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac net — network helpers

Usage:
  mac net ip
  mac net dns
  mac net flush-dns
  mac net routes
EOF
  exit 0
fi

shift
fn="net:${command}"

case "$fn" in
  net:ip)
    print -r -- "${COLOR_INFO}>> public IP${COLOR_RESET}"
    curl -s https://ifconfig.me && echo
    ;;

  net:dns)
    print -r -- "${COLOR_INFO}>> DNS servers${COLOR_RESET}"
    scutil --dns | grep 'nameserver\[[0-9]*\]' | head -n 10
    ;;

  net:flush-dns)
    print -r -- "${COLOR_INFO}>> flushing DNS cache${COLOR_RESET}"
    sudo killall -HUP mDNSResponder
    ;;

  net:routes)
    print -r -- "${COLOR_INFO}>> routes${COLOR_RESET}"
    netstat -rn
    ;;

  *)
    print_error "UNKNOWN NET SUBCOMMAND: ${command}"
    print_error "TRY: mac net --help"
    exit 2
    ;;
esac
