#!/bin/zsh
    # MACSTACK PLUGIN: mac-net
    # STYLE: UNIX / SNAKE_CASE
    # SHELL: ZSH
    #
    # PURPOSE: NETWORK HELPERS

    set -euo pipefail

    # DO NOT CHANGE THIS LINE (MACROOT RESOLUTION VIA SYMLINK-AWARE READLINK)
    MACROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
    # PLUGINS LIVE IN <REPO>/plugins, SO REPO ROOT IS PARENT
    MACROOT="$(cd "$MACROOT/.." && pwd)"

    # LOAD SHARED LIB
    if [[ ! -f "$MACROOT/lib/shared.zsh" ]]; then
      echo "mac: missing shared lib: $MACROOT/lib/shared.zsh" >&2
      exit 1
    fi
    source "$MACROOT/lib/shared.zsh"
    macstack_load_config || true

    command="${1:-}"
    if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
      cat <<'EOF'
    mac net — network helpers

Usage:
  mac net ip
  mac net dns
  mac net flush-dns
  mac net routes

    EOF
      exit 0
    fi

    shift
    fn="net:${command}"

    case "$fn" in

  "net:ip")
    echo -e "${COLOR_INFO}>> public IP${COLOR_RESET}"
    dig +short myip.opendns.com @resolver1.opendns.com
    ;;

  "net:local")
    echo -e "${COLOR_INFO}>> local IP${COLOR_RESET}"
    ipconfig getifaddr en0
    ;;

  "net:ssid")
    echo -e "${COLOR_INFO}>> connected Wi-Fi SSID${COLOR_RESET}"
    /System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport -I | awk -F ": " '/ SSID/ {print $2}'
    ;;

  "net:ports")
    echo -e "${COLOR_INFO}>> listening ports (TCP)${COLOR_RESET}"
    lsof -iTCP -sTCP:LISTEN -n -P
    ;;

esac
