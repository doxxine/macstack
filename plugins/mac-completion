#!/bin/zsh
# MACSTACK PLUGIN: mac-completion
# @describe: Generate shell completions

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac completion — generate shell completions

Usage:
  mac completion zsh

Install:
  mac completion zsh > ~/.zsh/completions/_mac
  # then add to .zshrc: fpath=(~/.zsh/completions $fpath)

  # or eval directly:
  eval "$(mac completion zsh)"
EOF
  exit 0
fi

shift

# Discover plugin subcommands by parsing --help output
# Looks for lines matching: mac <plugin> <subcommand>
discover_subcommands() {
  local plugin_name="$1"
  local plugin_path="$MACROOT/plugins/mac-${plugin_name}"
  [[ -x "$plugin_path" ]] || return 0

  "$plugin_path" --help 2>/dev/null | \
    grep -oE "mac ${plugin_name} [a-z][-a-z0-9]*" | \
    awk '{print $3}' | \
    sort -u
}

# Read @describe from plugin file
read_describe() {
  local plugin_path="$1"
  head -n 10 "$plugin_path" 2>/dev/null | \
    grep -m1 '^# @describe:' | \
    sed 's/^# @describe: *//'
}

case "$command" in

  zsh)
    # Discover all plugins
    local -a plugins=()
    local -A descriptions=()
    local -A subcommands=()

    for f in "$MACROOT/plugins"/mac-*; do
      [[ -e "$f" && -x "$f" ]] || continue
      local name="${f:t#mac-}"
      plugins+=("$name")
      descriptions[$name]="$(read_describe "$f")"
      subcommands[$name]="$(discover_subcommands "$name")"
    done

    cat <<'HEADER'
#compdef mac
# ZSH COMPLETION FOR MACSTACK
# Generated by: mac completion zsh

_mac() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '1:command:->command' \
    '*::arg:->args'

  case "$state" in
    command)
      local -a commands=(
        'help:Show help'
        'version:Print version'
        'list:List commands'
HEADER

    # Emit plugin entries
    for name in "${plugins[@]}"; do
      local desc="${descriptions[$name]:-}"
      if [[ -n "$desc" ]]; then
        printf "        '%s:%s'\n" "$name" "$desc"
      else
        printf "        '%s'\n" "$name"
      fi
    done

    cat <<'MIDDLE'
      )
      _describe 'command' commands
      ;;

    args)
      case "${line[1]}" in
MIDDLE

    # Emit subcommand completions per plugin
    for name in "${plugins[@]}"; do
      local subs="${subcommands[$name]:-}"
      [[ -n "$subs" ]] || continue

      printf "        %s)\n" "$name"
      printf "          local -a subcmds=(\n"

      echo "$subs" | while IFS= read -r sub; do
        [[ -n "$sub" ]] || continue
        printf "            '%s'\n" "$sub"
      done

      printf "          )\n"
      printf "          _describe 'subcommand' subcmds\n"
      printf "          ;;\n"
    done

    cat <<'FOOTER'
        list)
          local -a subcmds=('plugins')
          _describe 'subcommand' subcmds
          ;;
      esac
      ;;
  esac
}

_mac "$@"
FOOTER
    ;;

  *)
    print_error "UNSUPPORTED SHELL: ${command}"
    print_error "TRY: mac completion zsh"
    exit 2
    ;;

esac
