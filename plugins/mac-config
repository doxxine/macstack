#!/bin/zsh
# MACSTACK PLUGIN: mac-config
# @describe: Config diagnostics and resolution

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || true

sub="${1:-path}"

if [[ "$sub" == "--help" || "$sub" == "-h" ]]; then
  cat <<'EOF'
mac config — config diagnostics

Usage:
  mac config path
  mac config print
  mac config explain

Resolution order:
  1) $MACSTACK_CONFIG (explicit override)
  2) $XDG_CONFIG_HOME/macstack/macstack.conf (fallback ~/.config/...)
  3) <repo>/macstack.conf

Notes:
  - 'print' outputs the resolved config file content.
  - 'explain' prints the resolved path and the effective XDG locations.
EOF
  exit 0
fi

case "$sub" in

  path)
    if cfg="$(macstack_config_path)"; then
      print -r -- "$cfg"
      exit 0
    fi
    print_warn "CONFIG NOT FOUND"
    exit 1
    ;;

  print)
    if cfg="$(macstack_config_path)"; then
      cat -- "$cfg"
      exit 0
    fi
    print_warn "CONFIG NOT FOUND"
    exit 1
    ;;

  explain)
    print_info "XDG_CONFIG_HOME: ${XDG_CONFIG_HOME}"
    print_info "MACSTACK_CONFIG_DIR: ${MACSTACK_CONFIG_DIR}"
    print_info "MACSTACK_CONFIG_FILE: ${MACSTACK_CONFIG_FILE}"
    if [[ -n "${MACSTACK_CONFIG:-}" ]]; then
      print_info "MACSTACK_CONFIG: ${MACSTACK_CONFIG}"
    fi
    macstack_print_config_source || true
    exit 0
    ;;

  *)
    print_error "UNKNOWN SUBCOMMAND: $sub"
    print_error "TRY: mac config --help"
    exit 2
    ;;

esac
