#!/bin/zsh
# MACSTACK PLUGIN: mac-system
# STYLE: UNIX / SNAKE_CASE
# SHELL: ZSH
#
# PURPOSE:
# - SYSTEM UPDATE (BREW / CHEZMOI / OMZ / GIT REPOS)
# - SMALL SYSTEM UTILITIES (LOCK / DNS / CLEANUP / ETC.)
#
# CONFIG (OPTIONAL, VIA macstack_load_config):
# - USE_CHEZMOI_PULL="true|false"
# - OMZ_PLUGIN_ROOT="..."                 # FOLDER CONTAINING MULTIPLE GIT REPOS
# - WORKSPACE_TOOLS_ROOT="..."            # FOLDER CONTAINING MULTIPLE GIT REPOS
# - SYSTEM_UPDATE_PULL_QUIET="true|false" # DEFAULT: true
#
# NOTES:
# - THIS SCRIPT RUNS WITH 'set -euo pipefail'. ALWAYS GUARD OPTIONAL VARS WITH ${VAR:-}.
# - SOME COMMANDS REQUIRE sudo.

set -euo pipefail

# DO NOT CHANGE THIS LINE (MACROOT RESOLUTION VIA SYMLINK-AWARE READLINK)
MACROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
# PLUGINS LIVE IN <REPO>/plugins, SO REPO ROOT IS PARENT
MACROOT="$(cd "$MACROOT/.." && pwd)"

# LOAD SHARED LIB
if [[ ! -f "$MACROOT/lib/shared.zsh" ]]; then
  echo "mac: missing shared lib: $MACROOT/lib/shared.zsh" >&2
  exit 1
fi
source "$MACROOT/lib/shared.zsh"

# LOAD CONFIG (DEV + XDG; OPTIONAL FOR SYSTEM COMMANDS)
macstack_load_config || true

command="${1:-}"

if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac system — system utilities

Usage:
  mac system update
  mac system reboot
  mac system lock
  mac system clear-dns
  mac system copy-ssh-key
  mac system print-cancel
  mac system clean <logs|temp|cache|print|brew|docker|all>

Config (optional):
  USE_CHEZMOI_PULL="true|false"
  OMZ_PLUGIN_ROOT="/path/to/omz/plugins"
  WORKSPACE_TOOLS_ROOT="$HOME/workspace/tools"
  SYSTEM_UPDATE_PULL_QUIET="true|false"

Notes:
  - Some commands require sudo.
EOF
  exit 0
fi

shift
fn="system:${command}"

# HELPERS
pull_repo_dir() {
  local repo="$1"
  local name="$2"
  local quiet="${SYSTEM_UPDATE_PULL_QUIET:-true}"

  print -r -- " ${COLOR_SUCCESS}↪ ${name}${COLOR_RESET}"
  if [[ "$quiet" == "true" ]]; then
    git -C "$repo" pull --ff-only --quiet && print -r -- "  ✓ Updated" || print -r -- "  ! Skipped/No changes"
  else
    git -C "$repo" pull --ff-only && print -r -- "  ✓ Updated" || print -r -- "  ! Skipped/No changes"
  fi
}

pull_all_git_children() {
  local root="$1"
  local label="$2"

  if [[ ! -d "$root" ]]; then
    return 0
  fi

  print -r -- "${COLOR_INFO}>> ${label}: ${root}${COLOR_RESET}"

  local found=0
  local dir repo name
  for dir in "$root"/*/.git; do
    [[ -e "$dir" ]] || continue
    found=1
    repo="${dir%/.git}"
    name="$(basename "$repo")"
    pull_repo_dir "$repo" "$name"
  done

  if [[ "$found" -eq 0 ]]; then
    print -r -- "  (no git repos found)"
  fi
}

case "$fn" in
  system:update)
    print -r -- "${COLOR_BOLD}${COLOR_INFO}>>> SYSTEM UPDATE STARTED${COLOR_RESET}"

    if command -v brew >/dev/null 2>&1; then
      print -r -- "${COLOR_INFO}>> brew update && upgrade${COLOR_RESET}"
      brew update
      brew upgrade

      # OPTIONAL: BREW CASK/APP STORE UPGRADES VIA brew-cask-upgrade (brew cu)
      if command -v brew-cask-upgrade >/dev/null 2>&1 || brew cu --help >/dev/null 2>&1; then
        print -r -- "${COLOR_INFO}>> brew cu --all --cleanup --include-mas --yes${COLOR_RESET}"
        brew cu --all --cleanup --include-mas --yes || true
      fi

      brew upgrade --cask || true
      brew cleanup
    fi

    if command -v chezmoi >/dev/null 2>&1; then
      if [[ "${USE_CHEZMOI_PULL:-false}" == "true" ]]; then
        print -r -- "${COLOR_INFO}>> chezmoi update${COLOR_RESET}"
        chezmoi update
      else
        print -r -- "${COLOR_INFO}>> chezmoi apply (local-only)${COLOR_RESET}"
        chezmoi apply --force
      fi
    fi

    if command -v omz >/dev/null 2>&1; then
      print -r -- "${COLOR_INFO}>> omz update (verbose)${COLOR_RESET}"
      omz update --verbose || true
    fi

    # UPDATE OMZ PLUGINS (IF CONFIGURED)
    if [[ -n "${OMZ_PLUGIN_ROOT:-}" ]]; then
      pull_all_git_children "${OMZ_PLUGIN_ROOT}" "OMZ plugins"
    fi

    # UPDATE WORKSPACE TOOLS (IF CONFIGURED)
    if [[ -n "${WORKSPACE_TOOLS_ROOT:-}" ]]; then
      pull_all_git_children "${WORKSPACE_TOOLS_ROOT}" "tools"
    fi

    # OPTIONAL: POST-UPDATE CLEANUP (BEST-EFFORT)
    # THIS MIMICS YOUR LEGACY 'cleanup' ALIAS INTENT WITHOUT BEING DESTRUCTIVE BY DEFAULT.
    if [[ "${SYSTEM_UPDATE_RUN_CLEANUP:-false}" == "true" ]]; then
      print -r -- "${COLOR_INFO}>> post-update cleanup (system clean all)${COLOR_RESET}"
      "$0" clean all || true
    fi

    print -r -- "${COLOR_BOLD}${COLOR_SUCCESS}>>> SYSTEM UPDATE DONE${COLOR_RESET}";;

  system:reboot)
    print -r -- "♻️ Rebooting system..."
    sudo shutdown -r now
    ;;

  system:lock)
    print -r -- "${COLOR_INFO}>> locking screen${COLOR_RESET}"
    /System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend
    ;;

  system:clear-dns)
    print -r -- "${COLOR_INFO}>> clearing DNS cache${COLOR_RESET}"
    sudo killall -HUP mDNSResponder
    ;;

  system:copy-ssh-key)
    print -r -- "${COLOR_INFO}>> copying public SSH key to clipboard${COLOR_RESET}"
    if [[ -f "$HOME/.ssh/id_rsa.pub" ]]; then
      pbcopy < "$HOME/.ssh/id_rsa.pub"
    elif [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
      pbcopy < "$HOME/.ssh/id_ed25519.pub"
    else
      print -r -- "${COLOR_ERR}!! no public key found in ~/.ssh${COLOR_RESET}" >&2
      exit 1
    fi
    ;;

  system:print-cancel)
    print -r -- "${COLOR_INFO}>> cancelling all print jobs${COLOR_RESET}"
    cancel -a
    ;;

  system:clean)
    target="${1:-}"
    if [[ -z "$target" ]]; then
      print -r -- "${COLOR_ERR}!! missing cleanup target${COLOR_RESET}" >&2
      print -r -- "Try: mac system clean all" >&2
      exit 2
    fi

    print -r -- "${COLOR_INFO}>> cleaning: $target${COLOR_RESET}"
    case "$target" in
      logs)
        sudo rm -rf /private/var/log/* || true
        ;;
      temp)
        sudo rm -rf /private/var/tmp/* || true
        ;;
      cache|usercache)
        rm -rf ~/Library/Caches/* || true
        ;;
      print)
        cancel -a
        ;;
      brew)
        if command -v brew >/dev/null 2>&1; then
          brew cleanup
        fi
        ;;
      docker)
        if command -v docker >/dev/null 2>&1; then
          docker system prune -a -f
        fi
        ;;
      all)
        "$0" clean logs
        "$0" clean temp
        "$0" clean cache
        "$0" clean print
        "$0" clean brew
        "$0" clean docker
        ;;
      *)
        print -r -- "${COLOR_WARN}!! unknown cleanup target: $target${COLOR_RESET}" >&2
        exit 2
        ;;
    esac
    ;;

  *)
    print -r -- "${COLOR_ERR}!! unknown system subcommand: ${command}${COLOR_RESET}" >&2
    print -r -- "Try: mac system --help" >&2
    exit 2
    ;;
esac
