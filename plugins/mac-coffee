#!/bin/zsh
# MACSTACK PLUGIN: mac-coffee
# @describe: Caffeinate helpers (stay awake)

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || true

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac coffee — caffeinate helpers

Usage:
  mac coffee on
  mac coffee off
  mac coffee status
EOF
  exit 0
fi

shift

case "$command" in

  on)
    if pgrep -x caffeinate >/dev/null; then
      print_warn ">> already running"
    else
      print -r -- "${COLOR_INFO}>> enabling stay-awake mode${COLOR_RESET}"
      caffeinate -di &
      print_success ">> enabled"
    fi
    ;;

  off)
    if pkill caffeinate; then
      print_success ">> caffeinate stopped"
    else
      print_warn ">> caffeinate not running"
    fi
    ;;

  status)
    if pgrep -x caffeinate >/dev/null; then
      print_success ">> active (caffeinate running)"
    else
      print -r -- "${COLOR_INFO}>> off (no caffeinate process)${COLOR_RESET}"
    fi
    ;;

  *)
    print_error "UNKNOWN COFFEE SUBCOMMAND: ${command}"
    print_error "TRY: mac coffee --help"
    exit 2
    ;;

esac
