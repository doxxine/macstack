#!/bin/zsh
# MACSTACK PLUGIN: mac-git
# @describe: Git shortcuts (wip, undo, reset)

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || true

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac git — small git shortcuts

Usage:
  mac git wip           # add + commit "work in progress"
  mac git wipp          # add + commit + push "work in progress"
  mac git undo-commit   # soft reset HEAD~1
  mac git reset-clean   # hard reset + clean -df
  mac git size          # git object stats
EOF
  exit 0
fi

shift

case "$command" in

  wip)
    print -r -- "${COLOR_INFO}>> git add + commit (wip)${COLOR_RESET}"
    git add . && git commit -m "work in progress"
    ;;

  wipp)
    print -r -- "${COLOR_INFO}>> git add + commit + push (wip)${COLOR_RESET}"
    git add . && git commit -m "work in progress" && git push && print -r -- "${COLOR_SUCCESS}>> pushed${COLOR_RESET}"
    ;;

  undo-commit)
    print -r -- "${COLOR_INFO}>> undoing last commit (soft reset)${COLOR_RESET}"
    git reset --soft HEAD~1
    ;;

  reset-clean)
    print -r -- "${COLOR_INFO}>> hard reset + clean untracked${COLOR_RESET}"
    git reset --hard && git clean -df
    ;;

  size)
    print -r -- "${COLOR_INFO}>> repo object stats${COLOR_RESET}"
    git count-objects -vH
    ;;

  *)
    print_error "UNKNOWN GIT SUBCOMMAND: ${command}"
    print_error "TRY: mac git --help"
    exit 2
    ;;

esac
