#!/bin/zsh
# MACSTACK PLUGIN: mac-export
# @describe: Document export (Markdown/HTML to PDF)

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || { print_error "MISSING CONFIG (RUN: mac init)"; exit 1; }

command="${1:-}"
if [[ -z "$command" || "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
  cat <<'EOF'
mac export — document export

Usage:
  mac export markdown <input.md> --title "..." [--company "..."] [--context "a,b,c"]
  mac export html     <input.html> --title "..." [--company "..."] [--context "a,b,c"]

Notes:
  - markdown uses pandoc
  - html uses weasyprint
EOF
  exit 0
fi

shift

require_value() {
  local value="$1"
  local message="$2"
  if [[ -z "$value" ]]; then
    print_error "$message"
    exit 1
  fi
}

normalize_geometry() {
  local g="${1:-}"
  if [[ -z "$g" ]]; then
    print -r -- ""
    return 0
  fi
  if [[ "$g" != *"="* ]]; then
    g="margin=$g"
  fi
  print -r -- "$g"
}

build_output_filename() {
  local title="$1"
  local company="$2"
  local context_csv="${3:-}"
  local date_prefix="${4:-$(date +%Y%m%d)}"

  local base
  base="$(semantic_filename "$title" "$company" "$date_prefix")"

  if [[ -n "$context_csv" ]]; then
    local ctx
    ctx="$(print -r -- "$context_csv" | tr ',' '_' )"
    ctx="$(slugify "$ctx")"
    base="${base%.pdf}_${ctx}.pdf"
  fi

  print -r -- "$base"
}

# Shared argument parsing for export subcommands
parse_export_args() {
  TITLE=""
  COMPANY="${EXPORT_COMPANY:-private}"
  CONTEXT=""
  POSITIONAL=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) TITLE="${2:-}"; shift 2 ;;
      --company) COMPANY="${2:-}"; shift 2 ;;
      --context) CONTEXT="${2:-}"; shift 2 ;;
      *) POSITIONAL+=("$1"); shift ;;
    esac
  done

  INPUT="${POSITIONAL[1]:-}"

  require_value "$TITLE" "MISSING --title"
  require_value "$INPUT" "MISSING INPUT FILE"

  [[ -f "$INPUT" ]] || { print_error "INPUT NOT FOUND: $INPUT"; exit 1; }

  OUTDIR="$(export_target_directory)"
  OUTFILE_NAME="$(build_output_filename "$TITLE" "$COMPANY" "$CONTEXT")"
  OUTFILE="${OUTDIR}/${OUTFILE_NAME}"
}

case "$command" in

  markdown)
    parse_export_args "$@"

    pdf_engine="${EXPORT_MD_ENGINE:-pdflatex}"
    paper_size="${EXPORT_LAYOUT:-letter}"
    font_size="${EXPORT_MD_FONTSIZE:-11pt}"
    geom="$(normalize_geometry "${EXPORT_MARGIN:-1in}")"

    print -r -- "${COLOR_INFO}>> markdown -> pdf (pandoc)${COLOR_RESET}"
    pandoc "$INPUT" -o "$OUTFILE" \
      --pdf-engine="$pdf_engine" \
      -V "geometry:$geom" \
      -V "papersize=$paper_size" \
      -V "fontsize=$font_size"

    tag_file "$OUTFILE" "$CONTEXT"
    print_success "EXPORTED: $OUTFILE"
    ;;

  html)
    parse_export_args "$@"

    print -r -- "${COLOR_INFO}>> html -> pdf (weasyprint)${COLOR_RESET}"
    weasyprint "$INPUT" "$OUTFILE"

    tag_file "$OUTFILE" "$CONTEXT"
    print_success "EXPORTED: $OUTFILE"
    ;;

  *)
    print_error "UNKNOWN EXPORT SUBCOMMAND: $command"
    print_error "TRY: mac export --help"
    exit 2
    ;;

esac
