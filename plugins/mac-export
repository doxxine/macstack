#!/bin/zsh
# MACSTACK PLUGIN (UNIX-STYLE)
# NOTE: THIS IS AN EXECUTABLE "mac-<command>" PLUGIN.
# SHELL: ZSH

set -euo pipefail

# DO NOT CHANGE THIS LINE (MACROOT RESOLUTION VIA SYMLINK-AWARE READLINK)
MACROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
# PLUGINS LIVE IN <REPO>/plugins, SO REPO ROOT IS PARENT
MACROOT="$(cd "$MACROOT/.." && pwd)"

source "$MACROOT/lib/shared.zsh"

Command="${1:-}"
if [[ -z "$Command" || "$Command" == "help" || "$Command" == "--help" || "$Command" == "-h" ]]; then
  cat <<'EOF'
mac export — document export

Usage:
  mac export markdown <input.md> --title "..." [--company "..."] [--context "a,b,c"]
  mac export html     <input.html> --title "..." [--company "..."] [--context "a,b,c"]

Notes:
  - markdown uses pandoc
  - html uses weasyprint (if configured)
EOF
  exit 0
fi

# LOAD CONFIG (REPO-LOCAL)
CONFIG_FILE="$MACROOT/macstack.conf"
if [[ -f "$CONFIG_FILE" ]]; then
  source "$CONFIG_FILE"
fi

# SHIFT SUBCOMMAND AND FORWARD REST AS-IS
shift
ARGS=("$@")
set -- "${ARGS[@]}"

fn="export:${Command}"
case "$fn" in

  export:markdown)
    TITLE=""
    COMPANY="${EXPORT_COMPANY:-private}"
    CONTEXT="misc"
    POSITIONAL=()

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --title) TITLE="$2"; shift 2 ;;
        --company) COMPANY="$2"; shift 2 ;;
        --context) CONTEXT="$2"; shift 2 ;;
        *) POSITIONAL+=("$1"); shift ;;
      esac
    done

    set -- "${POSITIONAL[@]}"
    INPUT="$1"

    [[ -z "$TITLE" ]] && echo "❌ Missing --title" && exit 1
    [[ -z "$INPUT" ]] && echo "❌ Missing input file" && exit 1

    OUTDIR="$(export_target_directory "$CONTEXT")"
    OUTFILE_NAME="$(semantic_filename "$TITLE" "$COMPANY" "$CONTEXT")"
    OUTFILE="${OUTDIR}/${OUTFILE_NAME}"

    echo "🧾 Converting Markdown → PDF via Pandoc..."
    pandoc "$INPUT" -o "$OUTFILE" \
      --pdf-engine="${EXPORT_MD_ENGINE:-pdflatex}" \
      -V geometry="${EXPORT_MARGIN:-1in}" \
      -V papersize="${EXPORT_LAYOUT:-letter}" \
      -V fontsize=11pt

    tag_file "$OUTFILE" "$CONTEXT"
    echo "✅ Exported: $OUTFILE"
    ;;

  export:html)
    TITLE=""
    COMPANY="${EXPORT_COMPANY:-private}"
    CONTEXT="misc"
    POSITIONAL=()

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --title) TITLE="$2"; shift 2 ;;
        --company) COMPANY="$2"; shift 2 ;;
        --context) CONTEXT="$2"; shift 2 ;;
        *) POSITIONAL+=("$1"); shift ;;
      esac
    done

    set -- "${POSITIONAL[@]}"
    INPUT="$1"

    [[ -z "$TITLE" ]] && echo "❌ Missing --title" && exit 1
    [[ -z "$INPUT" ]] && echo "❌ Missing input file" && exit 1

    OUTDIR="$(export_target_directory "$CONTEXT")"
    OUTFILE_NAME="$(semantic_filename "$TITLE" "$COMPANY" "$CONTEXT")"
    OUTFILE="${OUTDIR}/${OUTFILE_NAME}"

    echo "🖨️  Converting HTML → PDF via WeasyPrint..."
    weasyprint "$INPUT" "$OUTFILE"

    tag_file "$OUTFILE" "$CONTEXT"
    echo "✅ Exported: $OUTFILE"
    ;;

  *)
    echo "❌ Unknown export subcommand: $fn"
    exit 1
    ;;

esac
