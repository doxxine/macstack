#!/bin/zsh
# MACSTACK PLUGIN: mac-doctor
# @describe: System health checks

set -euo pipefail

: "${MACROOT:=$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
source "$MACROOT/lib/bootstrap.zsh"
macstack_load_config || true

mode="${1:-}"

if [[ "$mode" == "--help" || "$mode" == "-h" ]]; then
  cat <<'EOF'
mac doctor — sanity checks

Usage:
  mac doctor
  mac doctor --audit

Default:
  Quick checks for shared lib, config resolution, and core tooling.

Audit:
  Validates:
  - XDG base dirs: ~/.config, ~/.local/share, ~/.cache, ~/.local/bin
  - PATH contains ~/.local/bin
  - workspace layout: ~/workspace/{tools,projects,raw/{inbox,export},org,archive,temp}
  - chezmoi state (single config file, source dir reachable)
  - presence of "base tools" (brew/git/gh/mas/direnv/zoxide/fzf/rg/fd/jq/gnupg)

Exit codes:
  0 OK
  1 warnings/failures detected
EOF
  exit 0
fi

FAIL=0

# ── OUTPUT HELPERS ───────────────────────────────────────────────────────────
ok()   { print -r -- "${COLOR_SUCCESS}OK${COLOR_RESET}   $*"; }
warn() { print -u2 -r -- "${COLOR_WARN}WARN${COLOR_RESET} $*"; FAIL=1; }
bad()  { print -u2 -r -- "${COLOR_ERR}FAIL${COLOR_RESET} $*"; FAIL=1; }

header() {
  print -r -- "${COLOR_INFO}#-------------------------------------------------------------#${COLOR_RESET}"
  print -r -- "${COLOR_BOLD}  MAC DOCTOR${COLOR_RESET}  ${COLOR_INFO}${1:-}${COLOR_RESET}"
  print -r -- "${COLOR_INFO}#-------------------------------------------------------------#${COLOR_RESET}"
}

has_cmd() { command -v "$1" >/dev/null 2>&1; }

check_dir() {
  local p="$1"
  local lbl="$2"
  if [[ -d "$p" ]]; then ok "$lbl: $p"; else bad "$lbl: missing ($p)"; fi
}

check_file() {
  local p="$1"
  local lbl="$2"
  if [[ -f "$p" ]]; then ok "$lbl: $p"; else warn "$lbl: missing ($p)"; fi
}

check_cmd() {
  local name="$1"
  if has_cmd "$name"; then ok "cmd: $name"; else warn "cmd: $name missing"; fi
}

check_path_contains() {
  local needle="$1"
  if print -r -- "$PATH" | tr ':' '\n' | grep -qx "$needle"; then
    ok "PATH contains: $needle"
  else
    bad "PATH missing: $needle"
  fi
}

# ── QUICK CHECKS ─────────────────────────────────────────────────────────────
quick_checks() {
  header "QUICK"

  check_file "$MACROOT/lib/shared.zsh" "shared lib"

  if cfg="$(macstack_config_path 2>/dev/null)"; then
    ok "config: $cfg"
  else
    warn "config: not found (run: mac init)"
  fi

  check_cmd "brew"
  check_cmd "git"
  check_cmd "gh"
  check_cmd "mas"
  check_cmd "chezmoi"
  check_cmd "direnv"
  check_cmd "zoxide"
  check_cmd "fzf"
  check_cmd "rg"
  check_cmd "fd"
  check_cmd "jq"
  check_cmd "gpg"
  check_cmd "pinentry-mac"
}

# ── AUDIT CHECKS ─────────────────────────────────────────────────────────────
audit_checks() {
  header "AUDIT (XDG + WORKSPACE + CHEZMOI + BASE TOOLS)"

  # XDG BASE
  local xdg_config="${XDG_CONFIG_HOME:-$HOME/.config}"
  local xdg_data="${XDG_DATA_HOME:-$HOME/.local/share}"
  local xdg_cache="${XDG_CACHE_HOME:-$HOME/.cache}"
  local xdg_bin="$HOME/.local/bin"

  check_dir "$xdg_config" "XDG_CONFIG_HOME"
  check_dir "$xdg_data" "XDG_DATA_HOME"
  check_dir "$xdg_cache" "XDG_CACHE_HOME"
  check_dir "$xdg_bin" "XDG BIN"
  check_path_contains "$xdg_bin"

  # WORKSPACE LAYOUT
  local ws="$HOME/workspace"
  check_dir "$ws" "workspace"
  check_dir "$ws/tools" "workspace/tools"
  check_dir "$ws/projects" "workspace/projects"
  check_dir "$ws/raw" "workspace/raw"
  check_dir "$ws/raw/inbox" "workspace/raw/inbox"
  check_dir "$ws/raw/export" "workspace/raw/export"
  check_dir "$ws/org" "workspace/org"
  check_dir "$ws/archive" "workspace/archive"
  check_dir "$ws/temp" "workspace/temp"

  # REDUNDANCY HINTS
  [[ -d "$ws/share" ]] && warn "redundant: workspace/share exists (prefer: ~/.local/share)" || ok "workspace/share: not present"
  [[ -d "$ws/.files" ]] && warn "redundant: workspace/.files exists (prefer: config repo)" || ok "workspace/.files: not present"
  [[ -d "$ws/setup" ]] && warn "redundant: workspace/setup exists (prefer: bootstrap repo)" || ok "workspace/setup: not present"

  # CHEZMOI STATE
  if has_cmd "chezmoi"; then
    ok "chezmoi: installed"
    local cfg_dir="$HOME/.config/chezmoi"
    local toml="$cfg_dir/chezmoi.toml"
    local yaml="$cfg_dir/chezmoi.yaml"

    if [[ -f "$toml" && -f "$yaml" ]]; then
      warn "chezmoi config: multiple files (chezmoi.toml + chezmoi.yaml) — keep only one"
    else
      ok "chezmoi config: single file"
    fi

    if [[ -f "$toml" ]]; then
      local src
      src="$(grep -E '^sourceDir' "$toml" 2>/dev/null | head -n 1 | sed 's/.*= *"//; s/"$//')"
      if [[ -n "$src" && -d "$src" ]]; then
        ok "chezmoi sourceDir: $src"
      elif [[ -n "$src" ]]; then
        warn "chezmoi sourceDir: missing ($src)"
      else
        warn "chezmoi sourceDir: not set in toml"
      fi
    fi
  else
    warn "chezmoi: missing (bootstrap should install it)"
  fi

  # BASE TOOLS
  check_cmd "brew"
  check_cmd "git"
  check_cmd "gh"
  check_cmd "mas"
  check_cmd "curl"
  check_cmd "zsh"
  check_cmd "direnv"
  check_cmd "zoxide"
  check_cmd "fzf"
  check_cmd "rg"
  check_cmd "fd"
  check_cmd "jq"
  check_cmd "gpg"
  check_cmd "pinentry-mac"

  # OPTIONAL BUT COMMON
  has_cmd "pandoc" && ok "cmd: pandoc" || warn "cmd: pandoc missing"
  has_cmd "weasyprint" && ok "cmd: weasyprint" || warn "cmd: weasyprint missing"
  has_cmd "tag" && ok "cmd: tag" || warn "cmd: tag missing"
  has_cmd "dotnet" && ok "cmd: dotnet" || warn "cmd: dotnet missing"
}

if [[ "$mode" == "--audit" ]]; then
  audit_checks
else
  quick_checks
fi

exit "$FAIL"
