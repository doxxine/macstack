#!/bin/zsh
# MACSTACK PLUGIN: mac-tools
# STYLE: UNIX / SNAKE_CASE
# SHELL: ZSH

set -euo pipefail

# DO NOT CHANGE THIS LINE (MACROOT RESOLUTION VIA SYMLINK-AWARE READLINK)
MACROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
# PLUGINS LIVE IN <REPO>/plugins, SO REPO ROOT IS PARENT
MACROOT="$(cd "$MACROOT/.." && pwd)"

# LOAD SHARED LIB
if [[ ! -f "$MACROOT/lib/shared.zsh" ]]; then
  echo "mac: missing shared lib: $MACROOT/lib/shared.zsh" >&2
  exit 1
fi
source "$MACROOT/lib/shared.zsh"
macstack_load_config || true

MACSTACK_MODE="subcommand:1"
MACROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)"
source "$MACROOT/lib/shared.zsh"

case "$fn" in

  "tools:serve")
    port=${1:-8000}
    echo -e "${COLOR_INFO}>> serving on http://localhost:$port${COLOR_RESET}"
    python3 -m http.server "$port"
    ;;

  "tools:fs")
    echo -e "${COLOR_INFO}>> size of: ${*:-.[^.]* *}${COLOR_RESET}"
    du -sh -- "${@:-.[^.]* *}"
    ;;

  "tools:trim")
    echo -e "${COLOR_INFO}>> trimming video from $2 to $3${COLOR_RESET}"
    ffmpeg -ss "$2" -to "$3" -i "$1" -c copy "${4:-trimmed-${1%.*}.${1##*.}}"
    ;;

  "tools:convert-webp")
    echo -e "${COLOR_INFO}>> converting all PNG to WebP in $2 with size $3x$4${COLOR_RESET}"
    mogrify -path "$2" -resize "$3"x"$4" -format webp *.png
    ;;

  "tools:mkexec")
    echo -e "${COLOR_INFO}>> chmod +x $1${COLOR_RESET}"
    chmod +x "$1"
    ;;

  "tools:retry")
    echo -e "${COLOR_INFO}>> retrying command until success${COLOR_RESET}"
    local n=0; until "$@"; do ((n++)); sleep 1; done
    ;;

  "tools:uuid")
    echo -e "${COLOR_INFO}>> generating UUID${COLOR_RESET}"
    uuidgen
    ;;

  "tools:timestamp")
    echo -e "${COLOR_INFO}>> unix timestamp now:${COLOR_RESET}"
    date +%s
    ;;

  "tools:timestamp:ms")
    echo -e "${COLOR_INFO}>> unix timestamp (ms) now:${COLOR_RESET}"
    echo $(( $(date +%s%N) / 1000000 ))
    ;;

  "tools:uuid:short")
    echo -e "${COLOR_INFO}>> short uuid:${COLOR_RESET}"
    uuidgen | cut -c1-8
    ;;

esac
