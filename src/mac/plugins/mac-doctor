#!/bin/zsh
set -euo pipefail

# MAC DOCTOR — QUICK SANITY CHECKS
# OUTPUT: HUMAN-READABLE BY DEFAULT
# EXIT: 0 OK, 1 WARN/FAIL

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'EOF'
mac doctor — quick sanity checks

Usage:
  mac doctor

Checks:
  - brew available
  - Xcode CLT selected
  - Homebrew prefix matches Apple Silicon (/opt/homebrew)
EOF
  exit 0
fi

fail=0

Check() {
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    echo "OK   $name"
  else
    echo "FAIL $name" >&2
    fail=1
  fi
}

Check "brew" command -v brew
Check "xcode-select" xcode-select -p

# OPTIONAL: CHECK BREW PREFIX (APPLE SILICON EXPECTATION)
if command -v brew >/dev/null 2>&1; then
  prefix="$(brew --prefix 2>/dev/null || true)"
  if [[ "$prefix" == "/opt/homebrew" ]]; then
    echo "OK   brew-prefix ($prefix)"
  else
    echo "WARN brew-prefix ($prefix) expected /opt/homebrew" >&2
    fail=1
  fi
fi

exit "$fail"